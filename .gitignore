# Track project sources and release metadata. Local builds, reports and environments stay ignored.
*
!/.gitignore
!/.clangd.template
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/AGENTS.md
!/LICENSE
!/LICENSES/
!/LICENSES/*.txt
!/MANIFEST.in
!/NOTICE
!/README.md
!/README_CN.md
!/config.yaml
!/pyproject.toml
!/setup.py
!/setup_clangd.sh
!/uv.lock

!/flashrwkv2/
!/flashrwkv2/**/
!/flashrwkv2/**/*.py
!/tests/
!/tests/**/
!/tests/**/*.py
!/benchmarks/
!/benchmarks/**/
!/benchmarks/**/*.py
!/ci/
!/ci/*.py
!/csrc/
!/csrc/**/
!/csrc/**/*.cpp
!/csrc/**/*.cu
!/csrc/**/*.cuh
!/csrc/**/*.h
!/csrc/**/*.hpp
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/.gitkeep
